<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Harness commonly runs over plain HTTP on loopback or a trusted LAN. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
